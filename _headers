# ---------------------------------------------------------------------------
# Security headers (no Cache-Control here so they never join cache rules)
# ---------------------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin

# ---------------------------------------------------------------------------
# Static assets
#
# IMPORTANT: CSS and JS keep stable filenames, so they must revalidate.
# Do not give them a long max-age unless the filename contains a content hash.
# ---------------------------------------------------------------------------
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Font filenames contain a content hash, so they can be cached permanently.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images use stable filenames, so do not mark them immutable.
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Browsers auto-request these at the root when a page omits <link rel=...>.
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/apple-touch-icon-precomposed.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# ---------------------------------------------------------------------------
# HTML / documents: always revalidate so a new deploy is visible immediately.
# Keep these rules disjoint from each other (no overlapping Cache-Control).
# ---------------------------------------------------------------------------
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/web-audit
  Cache-Control: public, max-age=0, must-revalidate

/web-audit/*
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/careers/*
  Cache-Control: public, max-age=0, must-revalidate

/faq/*
  Cache-Control: public, max-age=0, must-revalidate

/privacy/*
  Cache-Control: public, max-age=0, must-revalidate

/terms/*
  Cache-Control: public, max-age=0, must-revalidate

/success/*
  Cache-Control: public, max-age=0, must-revalidate

/fail/*
  Cache-Control: public, max-age=0, must-revalidate

/ro/*
  Cache-Control: public, max-age=0, must-revalidate

/ru/*
  Cache-Control: public, max-age=0, must-revalidate
