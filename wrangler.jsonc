{
  "name": "mwvitea",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/status", "/status/*"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://pqevbgelvgfalkwamkcl.supabase.co",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFxMnHMrFkj-1Ptx",
    "MAIL_FROM_NAME": "Midnight Webs",
    "GMAIL_USER": "contact.midnightwebs@gmail.com",
    "MAIL_TO": "contact.midnightwebs@gmail.com"
  },
  "observability": {
    "enabled": true
  }
}
