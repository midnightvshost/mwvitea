{
  "name": "midnight-webs",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/status", "/status/*"]
  },
  "vars": {},
  "observability": {
    "enabled": true
  }
}
